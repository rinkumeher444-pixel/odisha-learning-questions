            <th>निर्मित नया शब्द</th>
            <th>अर्थ में परिवर्तन</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>प्र-[span_133](start_span)[span_133](end_span)</strong></td>
            <td>शान्त</td>
            <td><strong>प्रशान्त[span_134](start_span)[span_134](end_span)</strong></td>
            <td>अत्यधिक शांत, पूरी तरह स्थिर</td>
          </tr>
          <tr>
            <td><strong>प्र-</strong></td>
            <td>गति</td>
            <td><strong>प्रगति</strong></td>
            <td>आगे बढ़ना, विकास</td>
          </tr>
          <tr>
            <td><strong>प्र-</strong></td>
            <td>बल</td>
            <td><strong>प्रबल</strong></td>
            <td>अत्यंत शक्तिशाली</td>
          </tr>
          <tr>
            <td><strong>प्र-</strong></td>
            <td>भाव</td>
            <td><strong>प्रभाव</strong></td>
            <td>गहरी छाप, असर</td>
          </tr>
          <tr>
            <td><strong>प्र-</strong></td>
            <td>सार</td>
            <td><strong>प्रसार</strong></td>
            <td>विस्तार, फैलाव</td>
          </tr>
          <tr>
            <td><strong>प्र-</strong></td>
            <td>यत्न</td>
            <td><strong>प्रयत्न</strong></td>
            <td>विशेष प्रयास, चेष्टा</td>
          </tr>
        </tbody>
