  <section id="reference-context">
    <h2 class="sec-title">📖 ९. महत्वपूर्ण अवतरणों का अर्थ एवं रिक्त स्थान पूर्ति</h2>

    <h3 class="sub-title">अवतरणों के अर्थ-स्पष्टीकरण (भाग ४)</h3>
    <div class="compare">
      <div class="card">
        <h4>१. "यदि फूल नहीं बो सकते तो काँटे कम-से-कम मत बोओ ।"</h4>
        <p><strong>अर्थ:</strong> यदि आपके पास दूसरों को सुख, शांति और आनंद देने का सामर्थ्य नहीं है, तो कम-से-कम अपने कटु वचनों या बुरे व्यवहार से किसी के मार्ग में बाधाएँ और दुःख मत उत्पन्न करो[span_89](start_span)[span_89](end_span) ।</p>
      </div>

      <div class="card">
        <h4>२. "ज्वालाएँ जब धुल जाती हैं, खुल-खुल जाते हैं मुँदे नयन ।"</h4>
        <p><strong>अर्थ:</strong> जब अंतःकरण से क्रोध, ईर्ष्या और संताप की आग प्रेम व ममता के जल से धुल जाती है, तब अज्ञानता की पट्टी हटती है और विवेक के बंद नेत्र सत्य को देखने लगते हैं[span_90](start_span)[span_90](end_span) ।</p>
      </div>

      <div class="card">
        <h4>୩. "है अगम चेतना की घाटी ।"</h4>
        <p><strong>अर्थ:</strong> उच्च जीवन-मूल्यों, आध्यात्मिक ज्ञान और आत्म-चेतना का मार्ग अत्यंत दुर्गम और गहरा है; इस पर चलने के लिए मन की दुर्बलताओं पर विजय पाना आवश्यक है[span_91](start_span)[span_91](end_span) ।</p>
      </div>

      <div class="card">
        <h4>୪. "सुख की अभिमानी मदिरा में जो जाग सका, वह है चेतन ।"</h4>
        <p><strong>अर्थ:</strong> सांसारिक सुख-सुविधाओं में अहंकार का नशा छा जाना स्वाभाविक है; परंतु जो व्यक्ति ऐश्वर्य में भी आत्म-विस्मृत न होकर सजग और विनम्र रहता है, वही सच्चा ज्ञानी व जीवित पुरुष है[span_92](start_span)[span_92](end_span) ।</p>
      </div>

      <div class="card">
        <h4>୫. "यदि बढ़ न सको विश्वासों पर साँसों के मुरदे मत ढोओ ।"</h4>
        <p><strong>अर्थ:</strong> यदि आप आशा और आत्मविश्वास के बल पर प्रगति-पथ पर आगे नहीं बढ़ सकते, तो हताशा और निराशा से घिरकर जिंदा लाश के समान व्यर्थ जीवन मत बिताओ[span_93](start_span)[span_93](end_span) ।</p>
      </div>
    </div>

