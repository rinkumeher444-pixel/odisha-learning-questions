  <style>
    :root {
      --bg: #0e1420;
      --bg-panel: #141d2e;
      --bg-card: #1a2436;
      --bg-card-hover: #223048;
      
      --gold: #f59e0b;
      --gold-glow: rgba(245, 158, 11, 0.15);
      --teal: #14b8a6;
      --teal-glow: rgba(20, 184, 166, 0.15);
      --green: #10b981;
      --green-glow: rgba(16, 185, 129, 0.15);
      --coral: #f43f5e;
      --coral-glow: rgba(244, 63, 94, 0.15);
      --blue: #38bdf8;
      --blue-glow: rgba(56, 189, 248, 0.15);
      
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --border: #2a3958;
      --border-light: #3b4f77;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(245, 158, 11, 0.08) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(20, 184, 166, 0.06) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(56, 189, 248, 0.04) 0px, transparent 50%);
      color: var(--text-main);
      font-family: 'Noto Serif Devanagari', 'Outfit', serif;
      line-height: 1.85;
      padding: 24px 16px;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
    }

    /* Hero Header */
    .hero {
      position: relative;
      background: linear-gradient(135deg, var(--bg-panel) 0%, #1a2744 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 42px 32px;
      overflow: hidden;
      margin-bottom: 32px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    }

    .hero-orbit {
      position: absolute;
      top: -40px;
      right: -40px;
      width: 290px;
      height: 290px;
      opacity: 0.22;
      pointer-events: none;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--gold-glow);
      color: var(--gold);
      border: 1px solid rgba(245, 158, 11, 0.3);
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 16px;
      text-transform: uppercase;
      font-family: 'Outfit', sans-serif;
    }

    .hero h1 {
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 12px;
      background: linear-gradient(to right, #ffffff, #fde68a, #67e8f9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 740px;
    }

    /* Pill Navigation */
    .pillnav {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 12px;
      margin-bottom: 32px;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    .pillnav::-webkit-scrollbar {
      height: 6px;
    }

    .pillnav::-webkit-scrollbar-thumb {
      background-color: var(--border);
      border-radius: 10px;
    }

    .pillnav a {
      white-space: nowrap;
      color: var(--text-muted);
      text-decoration: none;
      background: var(--bg-panel);
      padding: 8px 18px;
      border-radius: 50px;
      font-size: 0.88rem;
      font-weight: 500;
      border: 1px solid var(--border);
      transition: all 0.25s ease;
    }

    .pillnav a:hover {
      color: #fff;
      background: var(--bg-card);
      border-color: var(--gold);
      transform: translateY(-1px);
    }

    /* Section Structure */
    section {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 28px;
      margin-bottom: 32px;
    }

    h2.sec-title {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.45rem;
      color: var(--blue);
      margin-bottom: 22px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    h3.sub-title {
      font-size: 1.18rem;
      color: #e2e8f0;
      margin: 24px 0 14px;
    }

    p {
      margin-bottom: 14px;
      color: #cbd5e1;
      font-size: 1rem;
    }

    /* Callout Boxes */
    .callout {
      border-radius: var(--radius-md);
      padding: 18px 22px;
      margin: 20px 0;
      position: relative;
    }

    .def-box {
      background: var(--gold-glow);
      border-left: 4px solid var(--gold);
      border-top: 1px solid rgba(245, 158, 11, 0.2);
      border-right: 1px solid rgba(245, 158, 11, 0.2);
      border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    }
    .def-box strong { color: var(--gold); }

    .example-box {
      background: var(--teal-glow);
      border-left: 4px solid var(--teal);
      border-top: 1px solid rgba(20, 184, 166, 0.2);
      border-right: 1px solid rgba(20, 184, 166, 0.2);
      border-bottom: 1px solid rgba(20, 184, 166, 0.2);
    }
    .example-box strong { color: var(--teal); }

    .activity-box {
      background: var(--green-glow);
      border-left: 4px solid var(--green);
      border-top: 1px solid rgba(16, 185, 129, 0.2);
      border-right: 1px solid rgba(16, 185, 129, 0.2);
      border-bottom: 1px solid rgba(16, 185, 129, 0.2);
    }
    .activity-box strong { color: var(--green); }

    .mistake-box {
      background: var(--coral-glow);
      border-left: 4px solid var(--coral);
      border-top: 1px solid rgba(244, 63, 94, 0.2);
      border-right: 1px solid rgba(244, 63, 94, 0.2);
      border-bottom: 1px solid rgba(244, 63, 94, 0.2);
    }
    .mistake-box strong { color: var(--coral); }

    /* Comparison Grids */
    .compare {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
      margin: 22px 0;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 22px;
      transition: all 0.25s ease;
    }

    .card:hover {
      border-color: var(--border-light);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }

    .card h4 {
      font-size: 1.08rem;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card.teal h4 { color: var(--teal); }
    .card.coral h4 { color: var(--coral); }
    .card.green h4 { color: var(--green); }
    .card.gold h4 { color: var(--gold); }
    .card.blue h4 { color: var(--blue); }

    /* Flowcharts */
    .flow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      margin: 22px 0;
      padding: 18px;
      background: var(--bg-card);
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .flow-node {
      background: var(--bg-panel);
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 600;
      border: 1px solid var(--border-light);
      color: var(--text-main);
    }

    .flow-arrow {
      color: var(--blue);
      font-weight: bold;
      font-size: 1.3rem;
    }

    /* Diagram Styles */
    .diagram-container {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 24px;
      margin: 24px 0;
      text-align: center;
    }

    .diagram-container svg {
      max-width: 100%;
      height: auto;
    }

    figcaption {
      margin-top: 14px;
      font-size: 0.9rem;
      color: var(--text-muted);
      font-style: italic;
    }

    /* Tables */
    .table-wrap {
      overflow-x: auto;
      margin: 22px 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.96rem;
    }

    th {
      background: #192338;
      color: var(--blue);
      padding: 14px 16px;
      font-weight: 600;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      color: #cbd5e1;
    }

    tr:nth-child(even) {
      background: rgba(255, 255, 255, 0.02);
    }

    tr:last-child td {
      border-bottom: none;
    }

    ul, ol {
      padding-left: 22px;
      margin-bottom: 14px;
    }

    li {
      margin-bottom: 8px;
      color: #cbd5e1;
    }

    .badge-tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.8rem;
      margin-right: 6px;
      font-weight: 600;
    }
    .badge-tag.blue { background: rgba(56, 189, 248, 0.15); color: var(--blue); }
    .badge-tag.green { background: rgba(16, 185, 129, 0.15); color: var(--green); }
    .badge-tag.gold { background: rgba(245, 158, 11, 0.15); color: var(--gold); }
    .badge-tag.coral { background: rgba(244, 63, 94, 0.15); color: var(--coral); }

    footer {
      text-align: center;
      padding: 24px;
      color: var(--text-dim);
      font-size: 0.88rem;
    }

    @media (max-width: 640px) {
      body { padding: 12px 8px; }
      section { padding: 20px 16px; }
      .hero { padding: 24px 18px; }
    }
  </style>
</head>
